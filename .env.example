# ===================================================
# Photo Upload Service — Environment Variables
# ===================================================
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real values.
# ===================================================

# --- OPTIONAL (sensible defaults exist) ---

# HTTP server port
SERVER_PORT=8080

# Spring Boot active profile: local, prod
SPRING_PROFILES_ACTIVE=local

# Local storage directory (inside container: /app/uploads)
STORAGE_LOCAL_PATH=./uploads

# Logging level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
WEB_LOG_LEVEL=WARN

# Max file size per photo (MB)
UPLOAD_MAX_FILE_SIZE_MB=100

# Max total multipart request size (MB)
UPLOAD_MAX_REQUEST_SIZE_MB=2100

# Max files per upload request
UPLOAD_MAX_FILES_PER_REQUEST=20

# Max upload requests per minute per IP (prod default 200; local profile defaults to 1000)
# NOTE: all wedding guests behind the same public IP (venue WiFi / Render proxy) share this quota.
UPLOAD_RATE_LIMIT_PER_MINUTE=1000
